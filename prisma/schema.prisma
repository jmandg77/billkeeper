generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth ---

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions        Session[]
  accounts        Account[]
  bills           Bill[]
  budgets         MonthBudget[]
  bankConnections BankConnection[]
  settings        UserSettings?
  shares          AccountShare[]
  bankAccounts    BankAccount[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// --- Billkeeper ---

model Bill {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  dueDay          Int? // day of the month, 1-31
  isAutoPay       Boolean   @default(false)
  minPaymentCents Int?
  payUrl          String? // https link to the biller's payment page
  notifyDaysBefore Int? // remind this many days before dueDay; null = off
  linkedAccountId  String? // bank account whose balance becomes this bill's amount on sync
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]

  @@index([userId])
}

model Payment {
  id           Int       @id @default(autoincrement())
  billId       Int
  bill         Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  month        String // "YYYY-MM"
  paid         Boolean   @default(false)
  paidAt       DateTime?
  matchedTxnId String? // bank transaction that marked this paid, when synced
  notifiedAt   DateTime? // due-reminder sent for this month
  // A manually set amount on a linked bill holds for this month; sync stops
  // overwriting it until the next month starts fresh.
  amountOverriddenAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([billId, month])
  @@index([month])
}

model MonthBudget {
  id           Int       @id @default(autoincrement())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String // "YYYY-MM"
  balanceCents Int       @default(0)
  // When the balance was set; only bills paid after this deduct from it,
  // since earlier payments are already reflected in the number.
  balanceAsOf  DateTime?

  @@unique([userId, month])
}

// Accounts seen through the bank connection, refreshed on every sync so the
// bill form and settings can list them without calling the provider.
model BankAccount {
  accountId    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  orgName      String?
  balanceCents Int
  syncedAt     DateTime

  @@id([userId, accountId])
}

// Household sharing: a session whose email matches a share operates on the
// owner's data (bills, bank sync, reminder settings) instead of its own.
model AccountShare {
  id        Int      @id @default(autoincrement())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email     String   @unique
  createdAt DateTime @default(now())
}

model UserSettings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Due-reminder recipients; carrier email-to-text addresses work here too.
  // Empty = the user's login email.
  reminderEmails String[] @default([])
  updatedAt      DateTime @updatedAt
}

// Read-only bank sync (Teller first; SimpleFIN fits the same seam). See docs/bank-sync.md.
model BankConnection {
  id           Int       @id @default(autoincrement())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "teller" | "simplefin"
  status       String    @default("connected")
  secret       String? // provider access material (Teller: enrollment access token)
  enrollmentId String?
  institution  String?
  accountId    String? // provider account the bills are paid from; null = all
  accountName  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}
