# Postgres connection string.
# Local dev: run `npm run db:dev` and copy the DATABASE_URL it prints.
# Production: any free Postgres works (Prisma Postgres, Neon, Supabase).
DATABASE_URL=""

# Secret for signing sessions: `openssl rand -hex 32`
BETTER_AUTH_SECRET=""

# The app's public origin, e.g. http://localhost:5173 or https://yourapp.vercel.app
ORIGIN="http://localhost:5173"

# Shared demo account (optional). When both are set, the landing page shows
# a "Try the demo" button; demo data resets on every demo sign-in.
DEMO_EMAIL="demo@billkeeper.local"
DEMO_PASSWORD=""

# OAuth sign-in. Configure at least one provider.
# GitHub: https://github.com/settings/developers (callback: <ORIGIN>/api/auth/callback/github)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google: https://console.cloud.google.com/apis/credentials (callback: <ORIGIN>/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only needed for `prisma migrate dev` against the local dev DB
SHADOW_DATABASE_URL=""

# Due-reminder emails (optional). Create a free account at https://resend.com.
# Without a verified domain, Resend only delivers to the account owner's email
# and EMAIL_FROM must stay onboarding@resend.dev.
RESEND_API_KEY=""
EMAIL_FROM="billkeeper <onboarding@resend.dev>"
# Protects /api/cron/reminders; Vercel Cron sends it automatically: `openssl rand -hex 16`
CRON_SECRET=""
